<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
 <Bundle Name="iot-egine" Manufacturer="iot-egine" Version="$(var.Version)" UpgradeCode="83BA809B-37B2-4C8F-8AF8-F7BE004690C2" IconSourceFile="$(var.SourceRoot)\native\assets\product.ico">
  <BootstrapperApplication>
   <bal:WixStandardBootstrapperApplication LicenseUrl="" Theme="hyperlinkLicense" SuppressOptionsUI="yes"/>
  </BootstrapperApplication>
  <Chain DisableSystemRestore="yes"><MsiPackage SourceFile="$(var.MsiPath)" Compressed="yes" Vital="yes"/></Chain>
 </Bundle>
</Wix>
