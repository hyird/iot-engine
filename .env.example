HOST=0.0.0.0
PORT=1102

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=iot
DB_PASSWORD=iot
DB_DATABASE=iot

# TimescaleDB device_data 存储策略。压缩延迟必须大于可能发生 UPDATE/补写的窗口，
# 防止命令结果等回写命中已压缩 chunk。关闭后只停止后续自动压缩，不自动解压历史 chunk。
DEVICE_DATA_COMPRESSION_POLICY_ENABLED=true
DEVICE_DATA_CHUNK_INTERVAL_HOURS=168
DEVICE_DATA_COMPRESSION_AFTER_HOURS=168
DEVICE_DATA_MUTABLE_WINDOW_HOURS=48

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 异步报文日志固定写入可执行文件同级 logs/，每日轮换并保留最近 14 天。
# 可设为 TRACE / DEBUG / INFO / WARN / ERROR / OFF。
PACKET_LOG_LEVEL=DEBUG

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# GB28181 默认关闭；启用后，ZLMediaKit C SDK 由 iot-engine 在进程内启动。
# 媒体数据面使用 ZLM 自己的 worker，与 Ruvia 业务 worker、SIP loop 隔离。
GB28181_ENABLED=false
GB28181_SIP_DOMAIN=
GB28181_SIP_ID=
GB28181_SIP_HOST=0.0.0.0
GB28181_SIP_PUBLIC_IP=
GB28181_SIP_PORT=5060
GB28181_SIP_PASSWORD=
GB28181_SIP_TRANSPORT=udp
GB28181_REGISTRATION_TIMEOUT_SECONDS=180
GB28181_COMMAND_TIMEOUT_SECONDS=10
GB28181_INVITE_TIMEOUT_SECONDS=15
GB28181_NONCE_TTL_SECONDS=300
# GB28181 无时区时间按设备所在时区解释；中国标准时间为 UTC+8。
GB28181_DEVICE_TIMEZONE_OFFSET_MINUTES=480
GB28181_SIP_LOGGING=true
GB28181_MEDIA_TOKEN_SECRET=
GB28181_MEDIA_TOKEN_TTL_SECONDS=300
# 浏览器直连 ZLM 时填写前端的精确 Origin，禁止使用 *。
GB28181_MEDIA_CORS_ORIGIN=
GB28181_RECORDING_ENABLED=false
GB28181_RECORD_ROOT=
GB28181_RECORD_MAX_SEGMENT_SECONDS=3600
# ZLM 会分别创建同等数量的 EventPoller 和 WorkThread；默认各 1 个，
# 避免绕过 iot-engine 的总 CPU 预算。按压测结果显式调大。
ZLM_WORKER_THREADS=1
# ZLM 日志级别：0 Trace、1 Debug、2 Info、3 Warn、4 Error。
ZLM_LOG_LEVEL=2
ZLM_HTTP_PORT=8080
ZLM_HTTPS_PORT=8443
ZLM_RTSP_PORT=8554
ZLM_RTSPS_PORT=8322
ZLM_RTMP_PORT=1935
ZLM_RTMPS_PORT=1936
ZLM_RTC_PORT=8000
ZLM_SRT_PORT=9000
ZLM_TLS_ENABLED=false
ZLM_TLS_PEM_PATH=
ZLM_TLS_PASSWORD=
# 留空时根据 GB28181_RTP_PUBLIC_IP 和 ZLM_HTTP_PORT 生成播放地址。
ZLM_PUBLIC_BASE_URL=
GB28181_RTP_PUBLIC_IP=
GB28181_RTP_PORT_START=30000
GB28181_RTP_PORT_END=30500
