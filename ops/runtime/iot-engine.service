[Unit]
Description=IoT Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-engine
Group=iot-engine
EnvironmentFile=/etc/iot-engine/iot-engine.env
Environment=HOST=127.0.0.1
Environment=PORT=1102
Environment=PACKET_LOG_DIRECTORY=/var/lib/iot-engine/logs
WorkingDirectory=/var/lib/iot-engine
ExecStart=/opt/iot-engine/iot-engine
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iot-engine
UMask=0077

[Install]
WantedBy=multi-user.target
