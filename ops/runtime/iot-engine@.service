[Unit]
Description=IoT Engine %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iot-%i
Group=iot-%i
EnvironmentFile=/etc/iot-engine/shared.env
EnvironmentFile=/etc/iot-engine/%i.env
Environment=SERVICE_ROLE=%i
Environment=PACKET_LOG_DIRECTORY=/var/lib/iot-engine/%i/logs
WorkingDirectory=/var/lib/iot-engine/%i
ExecStart=/opt/iot-engine/iot-engine
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iot-engine/%i
UMask=0077

[Install]
WantedBy=multi-user.target
